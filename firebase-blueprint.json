  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Document de profil privé et statistiques d'un utilisateur identifié."
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Sous-collection des billets, locations et réservations de l'utilisateur."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/MarketplaceOrder" },
      "description": "Sous-collection des commandes unifiées (panier multi-services, achats boutique, locations) avec reçus et statuts."
    },
    "/users/{userId}/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/UserIncident" },
      "description": "Sous-collection des signalements de sentier enregistrés par l'utilisateur."
    },
    "/users/{userId}/eco_challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/EcoChallengeCompletion" },
      "description": "Sous-collection des défis écologiques Zéro Déchet validés et badges virtuels gagnés par l'utilisateur."
    },
    "/users/{userId}/eco_logs/{logId}": {
      "schema": { "$ref": "#/entities/EcoLogEntry" },
      "description": "Sous-collection du Carnet Éco-Log contenant les observations faune/flore de l'utilisateur."
    },
    "/users/{userId}/trusted_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/TrustedContact" },
      "description": "Sous-collection des proches importés depuis Google Contacts pour le partage de sécurité et d'expéditions."
    },
    "/users/{userId}/business_settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettlementSettings" },
      "description": "Sous-collection privée des paramètres commerciaux et comptes Mobile Money des versions Pro et Magasin."
    },
    "/expedition_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ExpeditionReview" },
      "description": "Avis et notes (1-5 étoiles) publiés par les utilisateurs pour chaque expédition."
    },
    "/community_activities/{activityId}": {
      "schema": { "$ref": "#/entities/CommunityActivity" },
      "description": "Fil communautaire des activités et sorties publiées par les utilisateurs."
    },
    "/community_activities/{activityId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommunityActivityComment" },
      "description": "Commentaires publiés sur les activités de la communauté."
    },
    "/community_activities/{activityId}/likes/{likeUserId}": {
      "schema": { "$ref": "#/entities/CommunityActivityLike" },
      "description": "Encouragements (likes) indexés par UID utilisateur sur une activité."
    },
    "/community_chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChatMessage" },
      "description": "Messages du chat communautaire temps réel par salon."
    },
    "/vendor_listings/{listingId}": {
      "schema": { "$ref": "#/entities/VendorListing" },
      "description": "Catalogue des offres publiées par les professionnels, prestataires et magasins partenaires."
    },
    "/pro_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/ProfessionalProfile" },
      "description": "Annuaire public des guides, ornithologues, botanistes, pisteurs et professionnels certifiés."
    },
    "/store_profiles/{storeId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Annuaire public des magasins outdoor et agences de location partenaires au Gabon."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicExplorerProfile" },
      "description": "Profils publics des explorateurs MANGOREMA (sans PII) pour annuaire communautaire et chat privé."
    },
    "/site_contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/SiteContribution" },
      "description": "Contributions terrain et photos des sites naturels et parcs nationaux du Gabon."
    },
    "/direct_chats/{chatId}": {
      "schema": { "$ref": "#/entities/DirectChat" },
      "description": "Conversations privées 1-à-1 entre deux utilisateurs participants."
    },
    "/direct_chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectChatMessage" },
      "description": "Messages privés temps réel d'une conversation 1-à-1."
    }
  }
}
