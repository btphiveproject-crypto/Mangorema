{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur MANGOREMA synchronisé avec Google Sign-In et statistiques de randonnée.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Identifiant unique Firebase Auth de l'utilisateur."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Nom complet affiché sur le profil."
        },
        "role": {
          "type": "string",
          "maxLength": 80,
          "description": "Rôle ou niveau écotouriste."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Numéro Mobile Money gabonais."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Adresse e-mail vérifiée via Google Sign-In."
        },
        "avatar": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL de la photo de profil."
        },
        "bio": {
          "type": "string",
          "maxLength": 400,
          "description": "Courte biographie d'explorateur ou de guide."
        },
        "homeCity": {
          "type": "string",
          "maxLength": 80,
          "description": "Ville ou province de base au Gabon."
        },
        "favoritePark": {
          "type": "string",
          "maxLength": 100,
          "description": "Parc national ou réserve de prédilection."
        },
        "publicDiscoverable": {
          "type": "boolean",
          "description": "Autorise l'affichage du profil public (sans PII) pour recevoir des messages privés."
        },
        "totalKm": {
          "type": "number",
          "description": "Distance cumulée parcourue en kilomètres."
        },
        "totalAscent": {
          "type": "number",
          "description": "Dénivelé positif cumulé en mètres."
        },
        "stepsCount": {
          "type": "number",
          "description": "Nombre total de pas enregistrés."
        },
        "subscription": {
          "type": "string",
          "enum": ["Gratuit (0 F)", "Starter (500 F)", "Club Medium (1 000 F)", "Pro Expé (2 000 F)"],
          "description": "Formule d'abonnement MANGOREMA Club."
        },
        "favoritePhotoIds": {
          "type": "array",
          "description": "Identifiants des photos coup de cœur (max 20)."
        },
        "topThreePhotoIds": {
          "type": "array",
          "description": "Identifiants des 3 photos mises en valeur en haut du profil (max 3)."
        },
        "ecoPoints": {
          "type": "number",
          "description": "Points écologiques cumulés via les défis Zéro Déchet."
        },
        "zeroWasteExpeditionsCount": {
          "type": "number",
          "description": "Nombre d'expéditions réalisées sans laisser de déchets."
        },
        "unlockedBadgeIds": {
          "type": "array",
          "description": "Identifiants des badges virtuels écologiques débloqués (max 30)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de création."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de dernière mise à jour."
        }
      },
      "required": ["uid", "name", "email", "totalKm", "totalAscent", "stepsCount", "subscription", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Billet électronique, location matériel ou réservation guide ANPN appartenant à un utilisateur.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "refNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "eventId": {
          "type": "string",
          "maxLength": 128
        },
        "eventTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "eventDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "shuttleIncluded": {
          "type": "boolean"
        },
        "shuttleDetail": {
          "type": "string",
          "maxLength": 200
        },
        "tentIncluded": {
          "type": "boolean"
        },
        "guideIncluded": {
          "type": "boolean"
        },
        "totalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["AIRTEL", "MOOV", "GHETTOPAY"]
        },
        "payerPhone": {
          "type": "string",
          "maxLength": 40
        },
        "timestamp": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["CONFIRMED", "USED"]
        },
        "qrCodeSeed": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "refNumber", "eventTitle", "eventDate", "location", "shuttleIncluded", "tentIncluded", "guideIncluded", "totalAmount", "paymentMethod", "payerPhone", "timestamp", "status", "qrCodeSeed", "createdAt"]
    },
    "UserIncident": {
      "title": "UserIncident",
      "description": "Signalement de danger ou vigilance sentier soumis par un randonneur authentifié.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["flood", "wildlife", "trail_blocked", "ranger_station", "medical"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "reportedAt": {
          "type": "string",
          "maxLength": 64
        },
        "verifiedByANPN": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "type", "title", "description", "lat", "lng", "severity", "reportedAt", "verifiedByANPN", "createdAt"]
    },
